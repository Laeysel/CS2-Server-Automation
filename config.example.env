# Kopie anlegen als config.env und ausfuellen.
# config.env ist per .gitignore ausgeschlossen und gehoert NICHT ins Repo.

# --- Pfade ---
STEAMCMD="/home/steam/steamcmd/steamcmd.sh"
INSTALL="/home/steam/Steam/steamapps/common/Counter-Strike Global Offensive"
LOG="/home/steam/cs2-update.log"

# --- Serverstart ---
# GSLT: https://steamcommunity.com/dev/managegameservers
GSLT_TOKEN=""
START_MAP="de_dust2"
GAME_TYPE=0
GAME_MODE=1

# --- Verhalten des Update-Skripts ---
# 1 = gameinfo.gi wird nach einem Update automatisch repariert
# 0 = es wird nur gewarnt und der Eintrag muss von Hand gesetzt werden
AUTO_FIX_GAMEINFO=1

# Logdatei wird ab dieser Groesse (Bytes) rotiert. 0 = nie.
LOG_MAX_BYTES=5242880
